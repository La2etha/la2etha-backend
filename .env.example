# --- Lahza backend environment ---
# Copy to .env and adjust for local development.

# Database (Postgres + pgvector). Async driver for the app, sync for Alembic.
# Host port 5433 (docker-compose maps 5433->5432) avoids clashing with a native
# PostgreSQL that may already own 5432.
DATABASE_URL=postgresql+asyncpg://la2etha:la2etha@localhost:5433/la2etha
ALEMBIC_DATABASE_URL=postgresql+psycopg://la2etha:la2etha@localhost:5433/la2etha

# Redis (RQ workers)
REDIS_URL=redis://localhost:6379/0

# Auth — CHANGE THIS in any real deployment
JWT_SECRET=change-me-in-production
JWT_LIFETIME_SECONDS=3600

# Storage backend: local_fs | r2 | gdrive
STORAGE_BACKEND=local_fs
MEDIA_ROOT=./media

# CV models
INSIGHTFACE_MODEL=buffalo_l
# comma-separated ONNX Runtime providers; falls back to CPU if CUDA missing
ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# Matching thresholds (cosine similarity)
ENROLL_MATCH_THRESHOLD=0.35

# Quality culling (F3) & background/proximity filtering (F4) — DEMOTE knobs.
# These only move photos to the gallery's secondary section; they never hide them.
# VoL is measured on a size-normalized copy (longest side 640px) so the threshold
# is comparable across cameras. If too many good photos land as "blurry", LOWER
# this; the stored per-photo `quality_score` shows you the actual distribution.
QUALITY_BLUR_MIN=55.0
# A face smaller than this fraction of the frame is treated as a bystander.
PROXIMITY_AREA_MIN=0.012
# Face-crop sharpness (VoL) below this corroborates an out-of-focus background face.
PROXIMITY_SHARPNESS_MIN=30.0

# --- Optional / later phases ---
# Google OAuth (FastAPI-Users)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Cloudflare R2 (Phase 8)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Google Gemini "Nano Banana" AI photo edit (F7 stretch, opt-in/consented,
# solo-photo-only). Free tier via Google AI Studio. Blank = edit endpoint 503s.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
