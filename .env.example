# --- La2etha! backend environment ---
# Copy to .env and adjust for local development.

# Database (Postgres + pgvector). Async driver for the app, sync for Alembic.
# Host port 5433 (docker-compose maps 5433->5432) avoids clashing with a native
# PostgreSQL that may already own 5432.
DATABASE_URL=postgresql+asyncpg://la2etha:la2etha@localhost:5433/la2etha
ALEMBIC_DATABASE_URL=postgresql+psycopg://la2etha:la2etha@localhost:5433/la2etha

# Redis (RQ workers)
REDIS_URL=redis://localhost:6379/0

# Auth — CHANGE THIS in any real deployment
JWT_SECRET=change-me-in-production
JWT_LIFETIME_SECONDS=3600

# Storage backend: local_fs | r2 | gdrive
STORAGE_BACKEND=local_fs
MEDIA_ROOT=./media

# CV models
INSIGHTFACE_MODEL=buffalo_l
# comma-separated ONNX Runtime providers; falls back to CPU if CUDA missing
ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# Matching thresholds (cosine similarity)
ENROLL_MATCH_THRESHOLD=0.35

# --- Optional / later phases ---
# Google OAuth (FastAPI-Users)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Cloudflare R2 (Phase 8)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Google Gemini "Nano Banana" (F7 stretch)
# GEMINI_API_KEY=
